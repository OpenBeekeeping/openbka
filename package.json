{
	"name": "openbka",
	"version": "0.0.1",
	"private": true,
	"description": "Open-source, self-hostable management platform for beekeeping associations",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "npm run clean:build && wrangler types --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4174",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run clean:build && wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest --passWithNoTests",
		"test": "npm run test:unit -- --run",
		"gen": "npm run clean:build && wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate": "wrangler d1 migrations apply DB --remote",
		"deploy": "npm run build && wrangler deploy",
		"clean:build": "node -e \"for (const d of ['output','cloudflare','cloudflare-tmp']) require('fs').rmSync('.svelte-kit/'+d,{recursive:true,force:true})\"",
		"setup": "wrangler d1 create openbka --jurisdiction eu",
		"test:e2e": "node scripts/e2e-sign-in.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"wrangler": "^4.97.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.1": true,
		"workerd@1.20261001.1": true
	},
	"dependencies": {
		"@openbeekeeping/design": "github:OpenBeekeeping/design#v0.1.0",
		"openid-client": "^6.8.8"
	},
	"overrides": {
		"@esbuild-kit/core-utils": {
			"esbuild": "^0.25.12"
		},
		"sharp": "^0.35.5"
	}
}
